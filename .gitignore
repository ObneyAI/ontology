# Clojure tooling and build output (includes local benchmark runs).
.cpcache/
.allium-loop/
target/
.clj-kondo/.cache/
.clj-kondo/imports/
.lsp/.cache/
.nrepl-port
*.class

# Python helper caches.
__pycache__/
*.py[cod]

# JVM crash diagnostics and heap dumps.
hs_err_pid*.log
replay_pid*.log
*.hprof

# macOS metadata and editor temporary files.
.DS_Store
*.swp
*.swo
*~

# Keep compact campaign summaries and consolidated results versionable.
# Per-case benchmark output belongs under target/.
/evidence/benchmarks/*/*/
/evidence/benchmarks/*/*.log
/evidence/benchmarks/*/manifest.json
/evidence/profiles/*/memory-*.edn
/evidence/profiles/*/memory-*.md
/evidence/profiles/*/sqlite-*.edn
/evidence/profiles/*/sqlite-*.md
