-- allium: 3
-- Standalone graph knowledge management. No execution or learning policy.

external entity OntologyConsumer { tenant_id: String }

value ConceptDefinition {
    uri: String
    label: String
    description: String
    scope: Any?
    alt_labels: List<String>?
    entity_type: String?
    broader_uris: List<String>?
    indicators: List<String>?
    provenance: Any?
    attributes: Any?
    embedding: Any?
    embedding_model: Any?
}

value ConceptChanges {
    scope: Any?
    alt_labels: List<String>?
    provenance: Any?
    entity_type: String?
    label: String?
    description: String?
    broader_uris: List<String>?
    indicators: List<String>?
    attributes: Any?
    embedding: Any?
    embedding_model: Any?
}

value ConceptMutationResult {
    ontology_id: String
    concept_id: String
    uri: String
    revision: Integer
}

value ConceptSelection {
    ontology_identifier: String?
    ontology_identifiers: List<String>?
    scope: Any?
    broader_uri: String?
}

value SearchRequest {
    query_text: String?
    lexical_method: String?
    seed_uris: List<String>?
    limit: Integer?
    max_depth: Integer?
    weights: Any?
    embed_query: Any?
    embedding_model: Any?
}

value ResolutionMatch {
    source_uri: String
    target_uri: String
    match_type: String
    similarity: Decimal
}

value ResolutionSummary {
    exact_matches: Integer
    semantic_matches: Integer
    matches: List<ResolutionMatch>?
}

-- Relationship metadata is opaque caller-owned data.
value RelationshipMetadata { data: Any? }

value ContributionRequest {
    source_identifier: String
    content_hash: String
    idempotency_key: String
    expected_revision: Integer?
    concepts: List<ConceptDefinition>
    relationships: Any?
    schema: Any?
    instances: Any?
    rdf_triples: Any?
    producer: Any?
    resolution_policy: Any?
}

contract CustomOntologyMutation {
    create_concept: (ontology: Ontology, definition: ConceptDefinition) -> Concept
    update_concept: (ontology: Ontology, concept: Concept, changes: ConceptChanges) -> Concept
    delete_concept: (ontology: Ontology, concept: Concept) -> ConceptMutationResult
    rename_concept: (ontology: Ontology, concept: Concept, new_uri: String) -> ConceptMutationResult
    merge_concepts: (ontology: Ontology, source: Concept, target: Concept) -> ConceptMutationResult
    create_relationship: (source: Concept, target: Concept, predicate: String, metadata: RelationshipMetadata) -> ConceptRelationship

    @invariant AtomicValidatedMutation
        -- Authorize and validate the complete change before appending any events.
        -- Failed validation and stale revisions leave the graph unchanged.
        -- Command retries return the original result without duplicate events.
        -- Expected failures are returned with explicit categories: invalid input,
        -- forbidden context, missing resources or conflicting writes. Unexpected
        -- implementation exceptions retain their diagnostic information.
        -- Created entity identifiers are independent of command identifiers;
        -- retries recover the originally generated entity identifiers.

    @invariant ExplicitConceptLifecycle
        -- Delete removes the concept and all incident links from current views.
        -- Rename keeps the UUID and moves all qualified endpoints to the new URI.
        -- Merge keeps the chosen target's identity and fields, combines alternate
        -- labels including the source label, redirects incident edges, drops new
        -- self-links and prefers existing target edges on collision.
        -- Each affected ontology advances once. Prior revisions and contribution
        -- evidence remain readable. Existing import mappings follow their target
        -- and disappear on deletion. A freed URI can acquire a fresh identity.
        -- RDF subject and resource object positions follow concept edits; literals
        -- retain their values. Schema type references follow rename and merge;
        -- delete rejects when a surviving schema record would lose its type.
        -- Built-in types and separately declared classes keep their own identity.

    @invariant AtomicHostVocabulary
        -- A host may prepare missing concepts and relationships for a vocabulary.
        -- Readers see those changes together with the host record in one commit.
        -- A stale preparation fails as a unit. Retrying preserves existing identities.

    @invariant HierarchyConsistency
        -- Broader and narrower are inverse views of one hierarchy. Updating
        -- parents removes obsolete inverse edges. Reject self-links and cycles.
        -- Imported and manually authored changes obey identical validation.
}

contract ScopedConceptLookup {
    get_ontology: (tenant_id: String, ontology_identifier: String) -> Ontology?
    list_ontologies: (tenant_id: String) -> List<Ontology>
    ontology_exists: (tenant_id: String, ontology_identifier: String) -> Boolean
    get_revision: (tenant_id: String, ontology_identifier: String) -> Integer?
    get_concept: (ontology: Ontology, concept_identifier: String) -> Concept?
    get_concept_by_uri: (ontology: Ontology, uri: String) -> Concept?
    list_concepts: (tenant_id: String, selection: ConceptSelection?) -> List<Concept>
    get_concept_map: (tenant_id: String, selection: ConceptSelection?) -> Any
    get_relationships: (ontology: Ontology) -> List<ConceptRelationship>
    get_contributions: (ontology: Ontology) -> Any
    get_sources: (ontology: Ontology) -> List<RegisteredSource>
    get_canonical_mappings: (ontology: Ontology) -> Any
    search: (ontology: Ontology, request: SearchRequest) -> Any
    export_snapshot: (ontology: Ontology, revision: Integer?) -> Any

    @invariant QualifiedIdentityRequired
        -- Individual concept lookups require tenant and ontology identity, plus
        -- either a concept UUID or URI. Both return the same concept view.
        -- URI-only global lookup is not part of the public graph contract.
        -- Field updates preserve concept UUID, ontology identity and URI.
        -- Only an explicit rename can move a surviving UUID to another URI.
        -- Collection reads may select one ontology, multiple ontologies or the
        -- whole tenant. The single and multiple selectors are mutually exclusive;
        -- an empty multiple selection returns no records. Scope and direct-parent
        -- filters are optional. Map results use qualified ontology/URI keys.

    @invariant ScopedIncrementalReads
        -- Point lookup reads events affecting the qualified concept and the
        -- policies needed to interpret its relationships. Changes identify both
        -- removed and added relationship endpoints. Unchanged records do not make
        -- those concepts affected.
        -- Repeated reads reuse prior projection progress and consume only new
        -- relevant events. Committed updates are visible on the next read.
        -- Projection progress is isolated by store, tenant and query scope;
        -- historical reads never advance beyond the requested revision.
        -- A committed retry reads its request stream without rebuilding the graph.

    @invariant SearchValidityAndDeterminism
        -- Traversal depth is a nonnegative integer and the result limit is a
        -- positive integer. Signal weights are finite and nonnegative.
        -- Omitted lexical method uses overlap. BM25 uses document frequencies and
        -- average document length within the requested ontology. Unknown methods reject.
        -- Lexical matching is case-insensitive; equal ranking scores use URI
        -- order. Seeds and locally reachable broader, narrower and related
        -- concepts through the requested depth are candidates before the public
        -- result limit is applied. No hidden candidate cap or activation cutoff
        -- removes otherwise reachable concepts. Unknown or foreign seeds are ignored.
        -- Omitted limit and depth use configured defaults. Supplied signal weights
        -- override the default weight independently for lexical, graph and embedding.
        -- Optional query embedding providers are called only with supplied query text;
        -- provider exceptions propagate. Ranking combines signal ranks, not probabilities.
        -- Vector comparison requires matching named models, equal dimensions,
        -- finite components and nonzero norms. Invalid vectors contribute no
        -- ranking signal; large finite vectors must not overflow comparison.

    @invariant ScopedSearchAndExport
        -- Reads never cross tenant boundaries. Concept collections follow the
        -- selected ontology scope; search returns identities in its requested graph.
        -- Relationship views and snapshots may include permitted links incident to
        -- another ontology in the same tenant, interpreted using the origin policy.
        -- Source and contribution history and canonical mappings are graph-scoped.
        -- No optional search provider is required for graph creation or retrieval.
        -- Missing single-resource lookups and revisions return no value.
        -- Explicit collection and search scopes must exist; a missing graph
        -- is reported as not found, including in a multi-graph selection.
        -- Existing graphs with no matches return empty collections.
        -- Export of a revision includes concepts, edges, schema and instances
        -- at that revision, and replay reproduces the same graph and provenance.
        -- Omitted revision selects the current graph revision.
}

contract GraphContributions {
    import_contribution: (ontology: Ontology, request: ContributionRequest) -> Contribution
    import_rdf: (ontology: Ontology, request: ContributionRequest, ntriples: String) -> Contribution
    register_predicate: (ontology: Ontology, policy: PredicatePolicy) -> PredicatePolicy

    @invariant ContributionIdentity
        -- Idempotency is tenant and ontology scoped. Same key and same request
        -- returns the original committed result, even after the graph advances.
        -- Same key with changed payload is rejected; a supplied stale expected revision
        -- on a new key is rejected. Neither rejection changes graph or history.
        -- Without an expected revision, imports validate against current state.
        -- Concurrent changes to that validated state prevent the commit.
        -- Content hash identifies source bytes, not every interpretation of them:
        -- a new key may re-extract unchanged content under another producer.
        -- Imports are additive upserts, not implicit deletion of older knowledge.

    @invariant ResolvedContributionChanges
        -- Each accepted contribution records only changed resolved records and
        -- explicit removals, together with its input, source and resolution evidence.
        -- Unchanged graph records are not repeated in the accepted changes.
        -- Applying those changes to the prior graph reproduces the validated
        -- candidate graph, including schema, instances and RDF triples.
        -- Changed records replace their prior values; relationship changes are
        -- authoritative, including removals when parents are replaced.
        -- Replay does not repeat identity resolution. Scoped projections and
        -- historical exports agree with a complete replay of accepted changes.
        -- A new contribution with no graph changes still records acceptance,
        -- provenance and a new revision; an identical retry adds no event.

    @invariant DeterministicResolutionAndMerge
        -- Explicit resolution policy combines exact identity, normalized labels
        -- and type-compatible matching. Both normalized-label and semantic matching
        -- require the same entity type; semantic comparisons require comparable
        -- supplied embeddings. Existing manual identities remain canonical.
        -- A supplied similarity threshold must be finite and between zero and one.
        -- Rewrite all edges to canonical identities, upsert changed concepts,
        -- retain mappings and bounded match scores, and validate the merged
        -- graph before an atomic commit. Snapshots and queries see that graph.
        -- Reject a resolution that would map one existing concept identity to
        -- another existing identity. Ambiguous candidate matches cannot collapse
        -- previously established identities or leave contradictory mappings.
        -- Permuting candidates within one contribution does not change its
        -- canonical graph content. Replaying preserves creation and update times.

    @invariant DeterministicRdfImport
        -- N-Triples parsing requires no external model. Preserve URI resources,
        -- literals, supported schema and instance triples in queries and export;
        -- unsupported or malformed input is rejected rather than silently lost.
        -- Parsing failures are invalid input; storage and implementation failures
        -- are not reclassified as parsing failures.

    @invariant OpaqueProducerProvenance
        -- Retain the original structured contribution separately from merged
        -- graph state so resolution decisions can be reconstructed. RDF imports
        -- retain the parsed contribution before canonicalization, not source text.
        -- Public contribution history exposes identity, ontology, source, input,
        -- canonical map, resolution evidence, original result and recording time.
        -- Retry digests remain internal. Accumulated canonical mappings contain
        -- URI pairs; match types and scores belong to contribution resolution evidence.
        -- Retain source ID, content hash, contribution identity, producer name
        -- and version, optional model metadata and opaque evidence references.
        -- Never interpret or dereference a producer's execution history.
}

entity Ontology {
    tenant_id: String
    ontology_id: String
    name: String
    scope: Any?
    description: String?
    base_uri: String?
    revision: Integer
    created_at: Timestamp
    concepts: Concept with ontology = this
    predicate_policies: PredicatePolicy with ontology = this
}

entity Concept {
    concept_id: String
    ontology: Ontology
    uri: String
    label: String
    description: String
    scope: Any?
    provenance: Any?
    alt_labels: List<String>?
    entity_type: Any?
    broader_uris: List<String>
    indicators: List<String>?
    attributes: Any?
    embedding: Any?
    embedding_model: Any?
    created_at: Timestamp
    updated_at: Timestamp?

    outgoing: ConceptRelationship with source = this
    incoming: ConceptRelationship with target = this
}

entity ConceptRelationship {
    source: Concept
    target: Concept
    predicate: String
    metadata: RelationshipMetadata?
    created_at: Timestamp
}

entity CanonicalMapping {
    ontology: Ontology
    source_uri: String
    canonical_uri: String
}

entity PredicatePolicy {
    ontology: Ontology
    predicate: String
    cross_ontology: Boolean
    symmetric: Boolean
    inverse: String?
    hierarchical: Boolean
}

entity RegisteredSource {
    ontology: Ontology
    source_identifier: String
    content_hash: String
    registered_at: Timestamp
}

entity Contribution {
    ontology: Ontology
    source: RegisteredSource
    idempotency_key: String
    request_digest: String
    revision: Integer
    input: Any
    canonical_map: Any
    resolution: ResolutionSummary
    result: Any
    recorded_at: Timestamp
}

config {
    search_limit: Integer = 10
    search_max_depth: Integer = 2
    search_signal_weight: Decimal = 1.0
}

rule InitializeOntology {
    when: InitializeOntologyRequested(consumer, name, scope, description, base_uri, predicate_policies)
    requires: nonblank(name)
    let ontology_id = new_identifier()
    ensures:
        let ontology = Ontology.created(
            tenant_id: consumer.tenant_id,
            ontology_id: ontology_id,
            name: name,
            scope: scope,
            description: description,
            base_uri: base_uri,
            revision: 1,
            created_at: now
        )
        for policy in initial_predicate_policies(predicate_policies):
            PredicatePolicy.created(ontology: ontology, predicate: policy_name(policy),
                cross_ontology: permits_cross_ontology(policy), symmetric: is_symmetric(policy),
                inverse: inverse_predicate(policy), hierarchical: is_hierarchical(policy))
    @guidance
        -- Initial policies combine supplied policies with defaults. skos:broader
        -- is hierarchical with inverse skos:narrower; skos:narrower has inverse
        -- skos:broader. skos:related and owl:sameAs are symmetric;
        -- rdfs:subClassOf is hierarchical. Supplied policies override defaults.
}

rule AddConcept {
    when: ConceptCreationRequested(ontology, definition)
    requires: nonblank(definition.uri)
    requires: nonblank(definition.label)
    requires: nonblank(definition.description)
    requires: ontology.concepts.none(concept => concept.uri = definition.uri)
    requires: definition.broader_uris = null or definition.broader_uris.all(uri => ontology.concepts.any(concept => concept.uri = uri))
    requires: hierarchy_definition_is_valid(ontology, definition)

    ensures: Concept.created(
        concept_id: new_identifier(),
        ontology: ontology,
        uri: definition.uri,
        label: definition.label,
        description: definition.description,
        scope: definition.scope,
        provenance: definition.provenance,
        alt_labels: definition.alt_labels,
        entity_type: definition.entity_type,
        broader_uris: definition.broader_uris ?? [],
        indicators: definition.indicators,
        attributes: definition.attributes,
        embedding: definition.embedding,
        embedding_model: definition.embedding_model,
        created_at: now,
        updated_at: null
    )
    ensures: ontology.revision = ontology.revision + 1
}

rule UpdateConcept {
    when: ConceptUpdateRequested(ontology, concept, changes)
    requires: concept.ontology = ontology
    requires: has_mutable_changes(changes)
    requires: changes.label = null or nonblank(changes.label)
    requires: changes.description = null or nonblank(changes.description)
    requires: changes.broader_uris = null or changes.broader_uris.all(uri => ontology.concepts.any(candidate => candidate.uri = uri))
    requires: updated_hierarchy_is_valid(ontology, concept, changes)
    ensures:
        if changes.scope != null:
            concept.scope = changes.scope
        if changes.alt_labels != null:
            concept.alt_labels = changes.alt_labels
        if changes.provenance != null:
            concept.provenance = changes.provenance
        if changes.entity_type != null:
            concept.entity_type = changes.entity_type
        if changes.label != null:
            concept.label = changes.label
        if changes.description != null:
            concept.description = changes.description
        if changes.broader_uris != null:
            concept.broader_uris = changes.broader_uris
        if changes.indicators != null:
            concept.indicators = changes.indicators
        if changes.attributes != null:
            concept.attributes = changes.attributes
        if embedding_change_supplied(changes):
            concept.embedding = changes.embedding
        if embedding_model_change_supplied(changes):
            concept.embedding_model = changes.embedding_model
        concept.updated_at = now
    ensures: ontology.revision = ontology.revision + 1
    @guidance
        -- Supplied values replace entire fields, including maps and lists;
        -- omitted fields remain unchanged. Empty parent lists remove parents.
        -- Scope and entity type changes refresh matching groups; alternate label
        -- changes replace prior aliases used for resolution.
}

rule DeleteConcept {
    when: ConceptDeletionRequested(ontology, concept)
    requires: concept.ontology = ontology
    requires: schema_survives_deletion(ontology, concept)
    ensures: not exists concept
    ensures: ontology.revision = ontology.revision + 1
}

rule RenameConcept {
    when: ConceptRenameRequested(ontology, concept, new_uri)
    requires: concept.ontology = ontology
    requires: nonblank(new_uri) and valid_destination_uri(ontology, concept, new_uri)
    requires: ontology.concepts.none(other => other.uri = new_uri)
    ensures: concept.uri = new_uri
    ensures: ontology.revision = ontology.revision + 1
}

rule MergeConcepts {
    when: ConceptMergeRequested(ontology, source, target)
    requires: source.ontology = ontology and target.ontology = ontology
    requires: source != target
    requires: merged_hierarchy_is_valid(ontology, source, target)
    ensures: not exists source
    ensures: target.alt_labels = combined_labels(source, target)
    ensures: ontology.revision = ontology.revision + 1
}

rule RegisterPredicate {
    when: PredicateRegistrationRequested(ontology, predicate, cross_ontology, symmetric, inverse, hierarchical)
    requires: nonblank(predicate)
    requires: registered_policy(ontology, predicate) = null
    ensures: PredicatePolicy.created(ontology: ontology, predicate: predicate,
        cross_ontology: cross_ontology, symmetric: symmetric, inverse: inverse, hierarchical: hierarchical)
    ensures: ontology.revision = ontology.revision + 1
}

rule LinkConcepts {
    when: RelationshipCreationRequested(source, target, predicate, metadata)
    let policy = registered_policy(source.ontology, predicate)
    requires: source != target
    requires: policy != null
    requires: source.ontology.tenant_id = target.ontology.tenant_id
    requires: policy.cross_ontology or source.ontology = target.ontology
    requires: source.outgoing.none(edge => edge.target = target and edge.predicate = predicate)
    requires: hierarchy_remains_valid(source, target, policy)
    ensures: ConceptRelationship.created(source: source, target: target,
        predicate: predicate, metadata: metadata, created_at: now)
    ensures: source.ontology.revision = source.ontology.revision + 1
    ensures:
        if target.ontology != source.ontology:
            target.ontology.revision = target.ontology.revision + 1
}

rule ImportContribution {
    when: ContributionImportRequested(ontology, request)
    requires: not contribution_exists(ontology, request.idempotency_key)
    requires: request.expected_revision = null or request.expected_revision = ontology.revision
    requires: contribution_is_valid(ontology, request)
    let merged = resolve_and_validate(ontology, request)
    ensures:
        if not source_version_exists(ontology, request.source_identifier, request.content_hash):
            RegisteredSource.created(ontology: ontology,
                source_identifier: request.source_identifier,
                content_hash: request.content_hash, registered_at: now)
    ensures: Contribution.created(ontology: ontology,
        source: source_version(ontology, request.source_identifier, request.content_hash),
        idempotency_key: request.idempotency_key,
        request_digest: contribution_digest(request),
        revision: ontology.revision + 1,
        input: request, canonical_map: resolved_mapping(merged),
        resolution: resolution_summary(merged), result: import_result(merged), recorded_at: now)
    ensures: CanonicalGraphCommitted(ontology: ontology, merged: merged)
    ensures: ontology.revision = ontology.revision + 1
}

rule RetryContribution {
    when: ContributionImportRequested(ontology, request)
    let prior = prior_contribution(ontology, request.idempotency_key)
    requires: prior != null
    requires: prior.request_digest = contribution_digest(request)
    ensures: ContributionReturned(contribution: prior)
}

rule RejectContribution {
    when: ContributionImportRequested(ontology, request)
    requires: contribution_conflicts_or_invalid(ontology, request)
    ensures: ContributionRejected(ontology: ontology, reason: rejection_reason(ontology, request))
}

rule SearchGraph {
    when: GraphSearchRequested(ontology, request)
    let limit = request.limit ?? config.search_limit
    let max_depth = request.max_depth ?? config.search_max_depth
    requires: limit > 0
    requires: max_depth >= 0
    ensures: GraphSearchCompleted(ontology: ontology,
        results: scoped_search(ontology, request, limit, max_depth, config.search_signal_weight))
}

rule ExportGraph {
    when: GraphExportRequested(ontology, revision)
    let selected_revision = revision ?? ontology.revision
    requires: selected_revision >= 1 and selected_revision <= ontology.revision
    ensures: GraphSnapshotReturned(ontology: ontology, revision: selected_revision,
        snapshot: replay_and_export(ontology, selected_revision))
}

invariant ConceptUrisAreUniqueWithinOntology {
    for a in Concepts:
        for b in Concepts:
            a != b and a.ontology = b.ontology implies a.uri != b.uri
}

invariant RelationshipEdgesAreUnique {
    for a in ConceptRelationships:
        for b in ConceptRelationships:
            a != b implies a.source != b.source or a.target != b.target or a.predicate != b.predicate
}

invariant ResolutionScoresAreBounded {
    for contribution in Contributions:
        for match in contribution.resolution.matches:
            match.similarity >= 0 and match.similarity <= 1
}

invariant TenantQualifiedRelationships {
    for edge in ConceptRelationships:
        edge.source.ontology.tenant_id = edge.target.ontology.tenant_id
}

invariant SourceVersionsAreScoped {
    for a in RegisteredSources:
        for b in RegisteredSources:
            a != b and a.ontology = b.ontology and a.source_identifier = b.source_identifier
                implies a.content_hash != b.content_hash
}

surface OntologyGraph {
    facing consumer: OntologyConsumer
    provides:
        InitializeOntologyRequested(consumer, name, scope, description, base_uri, predicate_policies)
        ConceptCreationRequested(ontology, definition)
        ConceptUpdateRequested(ontology, concept, changes)
        ConceptDeletionRequested(ontology, concept)
        ConceptRenameRequested(ontology, concept, new_uri)
        ConceptMergeRequested(ontology, source, target)
        RelationshipCreationRequested(source, target, predicate, metadata)
        PredicateRegistrationRequested(ontology, predicate, cross_ontology, symmetric, inverse, hierarchical)
        ContributionImportRequested(ontology, request)
        GraphSearchRequested(ontology, request)
        GraphExportRequested(ontology, revision)
    exposes:
        ConceptMutationResult
        Ontology
        Concept
        ConceptRelationship
        PredicatePolicy
        RegisteredSource
        for contribution in Contributions where contribution.ontology.tenant_id = consumer.tenant_id:
            contribution.idempotency_key
            contribution.ontology
            contribution.source
            contribution.input
            contribution.canonical_map
            contribution.resolution
            contribution.result
            contribution.recorded_at
        CanonicalMapping
    contracts:
        fulfils CustomOntologyMutation
        fulfils ScopedConceptLookup
        fulfils GraphContributions
    @guarantee TenantBoundary
        -- Every operation is authorized within the initiating tenant. Equal IDs
        -- and source hashes across tenants never share data or deduplication.
    @guarantee GraphOnly
        -- The graph lifecycle accepts domain data without requiring an execution
        -- engine, model workflow, trace subscription or caller namespace loader.
}
